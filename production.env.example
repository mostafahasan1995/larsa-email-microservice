# Production Environment Variables
NODE_ENV=production
PORT=3202

# NATS Configuration
NATS_HOST=pro-nats
NATS_PORT=4222
NATS_JETSTREAM=false

# Redis Configuration
REDIS_PORT=6379
REDIS_HOST=redis-master-0.redis-headless.default.svc.cluster.local
REDIS_DB=0
REDIS_PASSWORD=
REDIS_FAMILY=4

# MongoDB Configuration
DB_FULL_HOST=mongo-0.mongo.default.svc.cluster.local:27017,mongo-1.mongo.default.svc.cluster.local:27017,mongo-2.mongo.default.svc.cluster.local:27017,mongo-3.mongo.default.svc.cluster.local:27017

# Other Configuration
SHOW_ERRORS=false 